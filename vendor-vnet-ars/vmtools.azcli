# Script 5: Install networking tools on all Linux VMs
# Installs: traceroute, tcptraceroute, iperf, and other network utilities
# Dependencies: VMs must be deployed from Scripts 1-4

#Parameters
rg=lab-vendor-ars #Define your resource group
location=southcentralus #Set location

########## Enable Boot Diagnostics (Serial Console) ##########
echo Enabling boot diagnostics for all VMs
az vm boot-diagnostics enable --ids $(az vm list -g $rg --query '[].{id:id}' -o tsv) -o none

########## Install Networking Tools on Linux VMs ##########
echo Installing networking tools (traceroute, tcptraceroute, iperf, etc.)
nettoolsuri="https://raw.githubusercontent.com/dmauser/azure-vm-net-tools/main/script/nettools.sh"
for vm in `az vm list -g $rg --query "[?storageProfile.osDisk.osType=='Linux'].name" -o tsv`
do
 az vm extension set \
 --resource-group $rg \
 --vm-name $vm \
 --name customScript \
 --publisher Microsoft.Azure.Extensions \
 --protected-settings "{\"fileUris\": [\"$nettoolsuri\"],\"commandToExecute\": \"./nettools.sh\"}" \
 --force-update \
 --no-wait
done
